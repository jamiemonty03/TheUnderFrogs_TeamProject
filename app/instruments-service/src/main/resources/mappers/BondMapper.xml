<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neueda.instrumentservice.repositories.BondRepository">

    <!--
        clean_bonds has no yield_to_maturity/coupon_rate/duration columns - the ETL treats
        bonds as fund-shaped data (identical shape to ETFs, per build_fund_row in
        01-generate_raw_instruments.py), so those Bond fields are left unmapped/null here.
    -->
    <resultMap id="BondResultMap" type="com.neueda.instrumentservice.models.Bond">
        <id column="symbol" property="symbol" />
        <result column="name" property="name" />
        <result column="price" property="price" />
        <result column="trade_date" property="tradeDate" />
        <result column="category" property="category" />
        <result column="fund_family" property="fundFamily" />
        <result column="legal_type" property="legalType" />
        <result column="net_expense_ratio" property="netExpenseRatio" />
        <result column="nav_price" property="navPrice" />
        <result column="total_assets" property="totalAssets" />
        <result column="net_assets" property="netAssets" />
        <result column="ytd_return" property="ytdReturn" />
        <result column="three_year_avg_return" property="threeYearAvgReturn" />
        <result column="five_year_avg_return" property="fiveYearAvgReturn" />
        <result column="beta_3_year" property="beta3Year" />
        <result column="distribution_yield" property="distributionYield" />
        <result column="version" property="version" />
        <result column="created_at" property="createdAt" />
        <result column="last_updated" property="lastUpdated" />
        <result column="updated_by" property="updatedBy" />
    </resultMap>

    <sql id="selectBond">
        SELECT i.symbol, i.name, lp.close AS price, lp.trade_date,
               cb.category, cb.fund_family, cb.legal_type, cb.net_expense_ratio,
               cb.nav_price, cb.total_assets, cb.net_assets, cb.ytd_return,
               cb.three_year_avg_return, cb.five_year_avg_return, cb.beta_3_year,
               cb.distribution_yield, cb.version, cb.created_at, cb.last_updated, cb.updated_by
        FROM clean_bonds cb
        JOIN instruments i ON i.symbol = cb.symbol
        LEFT JOIN LATERAL (
            SELECT close, date::timestamp AS trade_date
            FROM clean_prices cp
            WHERE cp.symbol = cb.symbol
            ORDER BY cp.date DESC
            LIMIT 1
        ) lp ON true
    </sql>

    <select id="findAll" resultMap="BondResultMap">
        <include refid="selectBond" />
        ORDER BY i.symbol
    </select>

    <select id="findBySymbol" parameterType="String" resultMap="BondResultMap">
        <include refid="selectBond" />
        WHERE cb.symbol = #{symbol}
    </select>

</mapper>

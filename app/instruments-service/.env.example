SPRING_DATASOURCE_URL=jdbc:postgresql://instruments-db:5432/instruments_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=ENTER_PASSWORD_HERE
# Optional: where tokens come from. The defaults match docker-compose.
# AUTH_JWKS_URI=http://auth-service:8081/.well-known/jwks.json
# AUTH_ISSUER=auth-service
# AUTH_AUDIENCE=trading-platform
# Alpaca credentials are required for GET /api/news.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_NEWS_URL=https://data.alpaca.markets/v1beta1/news

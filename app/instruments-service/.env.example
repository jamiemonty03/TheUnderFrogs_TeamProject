SPRING_DATASOURCE_URL=jdbc:postgresql://instruments-db:5432/instruments_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=ENTER_PASSWORD_HERE
# Must exactly match JWT_SECRET in accounts-service/.env to accept its JWTs.
JWT_SECRET=your-generated-secret-token-here


# ETL Configuration Template
# Orders Database (read-only for orders table)
ORDERS_DB_URL=jdbc:postgresql://orders-db:5432/orders_db
ORDERS_DB_USERNAME=postgres
ORDERS_DB_PASSWORD=ENTER_PASSWORD_HERE

# Accounts Database (read-only for accounts table)
ACCOUNTS_DB_URL=jdbc:postgresql://accounts-db:5432/accounts_db
ACCOUNTS_DB_USERNAME=postgres
ACCOUNTS_DB_PASSWORD=ENTER_PASSWORD_HERE

# Instruments Database (read-only for instruments table)
INSTRUMENTS_DB_URL=jdbc:postgresql://instruments-db:5432/instruments_db
INSTRUMENTS_DB_USERNAME=postgres
INSTRUMENTS_DB_PASSWORD=ENTER_PASSWORD_HERE

# Analytics Database (read-write for analytics schema)
# Uses same host as instruments-db, but analytics schema
ANALYTICS_DB_URL=jdbc:postgresql://instruments-db:5432/instruments_db
ANALYTICS_DB_USERNAME=postgres
ANALYTICS_DB_PASSWORD=ENTER_PASSWORD_HERE

# Logging
LOG_LEVEL=INFO
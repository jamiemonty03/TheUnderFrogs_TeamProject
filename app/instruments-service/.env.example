SPRING_DATASOURCE_URL=jdbc:postgresql://instruments-db:5432/instruments_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=ENTER_PASSWORD_HERE
# Optional: where tokens come from. The defaults match docker-compose.
# AUTH_JWKS_URI=http://auth-service:8081/.well-known/jwks.json
# AUTH_ISSUER=auth-service
# AUTH_AUDIENCE=trading-platform

# Optional: Kafka broker for live prices (market-data topic). The default matches docker-compose.
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Alpaca credentials are required for GET /api/news.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_NEWS_URL=https://data.alpaca.markets/v1beta1/news


# Optional: the AI trading assistant. Get a free key at console.groq.com.
# Without AI_API_KEY the assistant reports itself as unavailable; everything else still works.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_FALLBACK_MODEL=openai/gpt-oss-20b

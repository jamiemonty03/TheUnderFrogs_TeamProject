KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ORDERS_URL=http://orders-service:8081/api/orders
INSTRUMENTS_URL=http://instruments-service:8081/api/instruments
# Base URL for /stocks, /etfs and /bonds daily closes (fallback when no live Alpaca quote is usable)
PRICES_URL=http://instruments-service:8081/api

ACCOUNTS_URL=http://accounts-service:8081/api/accounts
POSITIONS_URL=http://positions-service:8081/api/positions

# Your own free Alpaca paper-trading keys (key ID starts with PK). Leave blank to price from the daily close only.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# How often the market-data poller asks Alpaca for quotes
MARKET_DATA_POLL_INTERVAL_MS=5000
# Generate one strong secret and use the exact same value in both services' .env files.
JWT_SECRET=your-generated-secret-token-here
SERVICE_TOKEN_TTL=86400000

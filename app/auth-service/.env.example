# Database (DB_HOST and DB_PORT are set by docker-compose)
DB_USERNAME=postgres
DB_PASSWORD=ENTER_PASSWORD_HERE
DB_NAME=auth_db

# Must exactly match JWT_SECRET in the other services, at least 32 characters
JWT_SECRET=your-generated-secret-token-here-must-be-32-chars-min

# RS256 signing key (private, never commit). Generate with: ./scripts/generate-signing-key.sh
JWT_PRIVATE_KEY=
JWT_KEY_ID=

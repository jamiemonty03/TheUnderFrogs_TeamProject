<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neueda.accountservice.repositories.AccountRepository">

    <!-- Result Map for mapping database columns to Account object -->
    <resultMap id="AccountResultMap" type="com.neueda.accountservice.models.Account">
        <id column="account_id" property="accountId" />
        <result column="holder_name" property="holderName" />
        <result column="cash_balance" property="cashBalance" />
        <result column="status" property="status" />
        <result column="version" property="version" />
        <result column="created_at" property="createdAt" />
        <result column="last_updated" property="lastUpdated" />
        <result column="updated_by" property="updatedBy" />
    </resultMap>

    <!-- INSERT: Create a new account -->
    <insert id="save" parameterType="com.neueda.accountservice.models.Account">
        INSERT INTO accounts (account_id, holder_name, cash_balance, status, version, created_at, last_updated, updated_by)
        VALUES (#{accountId}, #{holderName}, #{cashBalance}, #{status}, #{version}, #{createdAt}, #{lastUpdated}, #{updatedBy})
    </insert>

    <!-- SELECT: Get account by ID -->
    <select id="findById" parameterType="String" resultMap="AccountResultMap">
        SELECT * FROM accounts WHERE account_id = #{accountId}
    </select>

    <!-- SELECT: Check if account exists -->
    <select id="exists" parameterType="String" resultType="boolean">
        SELECT COUNT(*) > 0 FROM accounts WHERE account_id = #{accountId}
    </select>

    <!-- UPDATE: Update an existing account -->
    <update id="update" parameterType="com.neueda.accountservice.models.Account">
        UPDATE accounts 
        SET holder_name = #{holderName}, 
            cash_balance = #{cashBalance}, 
            status = #{status}, 
            version = #{version}, 
            last_updated = #{lastUpdated}, 
            updated_by = #{updatedBy}
        WHERE account_id = #{accountId}
    </update>

    <!-- DELETE: Delete an account by ID -->
    <delete id="delete" parameterType="String">
        DELETE FROM accounts WHERE account_id = #{accountId}
    </delete>

</mapper>

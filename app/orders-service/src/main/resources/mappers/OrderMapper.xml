<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neueda.orderservice.repositories.OrderRepository">

    <resultMap id="OrderResultMap" type="com.neueda.orderservice.models.Order">
        <id column="order_id" property="orderId" />
        <result column="idempotency_key" property="idempotencyKey" />
        <result column="account_id" property="accountId" />
        <result column="symbol" property="symbol" />
        <result column="side" property="side" typeHandler="org.apache.ibatis.type.EnumTypeHandler" />
        <result column="quantity" property="quantity" />
        <result column="price" property="price" />
        <result column="order_status" property="orderStatus" typeHandler="org.apache.ibatis.type.EnumTypeHandler" />
        <result column="version" property="version" />
        <result column="created_at" property="createdAt" />
        <result column="last_updated" property="lastUpdated" />
        <result column="updated_by" property="updatedBy" />
    </resultMap>

    <insert id="save" parameterType="com.neueda.orderservice.models.Order">
        INSERT INTO orders (order_id, idempotency_key, account_id, symbol, side, quantity, price, order_status, version, created_at, last_updated, updated_by)
        VALUES (#{orderId}, #{idempotencyKey}, #{accountId}, #{symbol}, #{side}, #{quantity}, #{price}, #{orderStatus}, #{version}, #{createdAt}, #{lastUpdated}, #{updatedBy})
    </insert>

    <update id="update" parameterType="com.neueda.orderservice.models.Order">
        UPDATE orders
        SET side = #{side}, quantity = #{quantity}, price = #{price}, order_status = #{orderStatus},
            version = #{version}, last_updated = #{lastUpdated}, updated_by = #{updatedBy}
        WHERE order_id = #{orderId}
    </update>

    <select id="findById" parameterType="String" resultMap="OrderResultMap">
        SELECT * FROM orders WHERE order_id = #{orderId}
    </select>

    <select id="findAll" resultMap="OrderResultMap">
        SELECT * FROM orders ORDER BY created_at DESC
    </select>

    <select id="findByAccountId" parameterType="String" resultMap="OrderResultMap">
        SELECT * FROM orders WHERE account_id = #{accountId} ORDER BY created_at DESC
    </select>

    <delete id="delete" parameterType="String">
        DELETE FROM orders WHERE order_id = #{orderId}
    </delete>

    <select id="exists" parameterType="String" resultType="boolean">
        SELECT COUNT(*) > 0 FROM orders WHERE order_id = #{orderId}
    </select>

</mapper>

%%{init: {'sequence': {'mirrorActors': false}}}%%
sequenceDiagram
    actor C as Client
    participant O as OrderProcessor
    participant S as OrderService
    participant V as OrderValidationService
    participant A as AccountService
    participant P as PositionManager
    participant PS as PositionService
    participant R as PositionRepository
    participant X as OrderExecutionStrategy

    C->>+O: processOrder(account, instrument, side, quantity, price, idempotencyKey)
    O->>+S: placeOrder(account, instrument, side, quantity, price, idempotencyKey)
    S->>+V: validateOrder(account, instrument, side, quantity, price)
    V->>V: validate account is active
    V->>V: validate instrument is present and tradable
    V->>V: validate quantity and price

    alt order is invalid
        V-->>S: throw validation exception
        S-->>O: reject order creation
        O-->>C: validation failure
    else order is valid
        alt side is SELL
            V->>+R: findByAccountAndSymbol(accountId, symbol)
            R-->>-V: current position or empty
            V->>V: verify sufficient holdings
        else side is BUY
            V->>V: verify sufficient cash
        end

        V-->>-S: validation passed
        S->>S: create order with status NEW
        S->>S: save new order
        S-->>-O: order

        alt side is BUY
            O->>X: select BuyOrderStrategy
            O->>+X: execute(order, account, instrument)
            X->>+A: debit(account, price x quantity)
            A-->>-X: cash debited
            X->>+P: updatePositionAfterBuy(accountId, symbol, quantity, price)
            P->>+R: find or create position
            R-->>-P: position
            P->>+PS: applyBuy(position, quantity, price)
            PS->>PS: add quantity and recalculate average cost
            PS-->>-P: updated position
            P->>R: save(position)
            R-->>-P: saved
            P-->>-X: position updated
        else side is SELL
            O->>X: select SellOrderStrategy
            O->>+X: execute(order, account, instrument)
            X->>+A: credit(account, price x quantity)
            A-->>-X: cash credited
            X->>+P: updatePositionAfterSell(accountId, symbol, quantity)
            P->>+R: find position
            R-->>-P: current position
            P->>+PS: applySell(position, quantity)
            PS->>PS: subtract quantity
            PS-->>-P: updated position
            alt position quantity is zero
                P->>R: delete(accountId, symbol)
                R-->>P: deleted
            else position quantity remains
                P->>R: save(position)
                R-->>P: saved
            end
            P-->>-X: position updated
        end

        X->>X: mark order FILLED
        X-->>-O: OrderResult(success)
        O->>S: saveOrder(order with final status)
        S-->>O: saved order
        O-->>-C: OrderResult
    end

    Note over X,R: On execution failure, the strategy marks the order REJECTED and attempts to reverse the cash movement.
